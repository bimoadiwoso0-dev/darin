# ─────────────────────────────────────────────────────────────
#  Darin LMS — نمونه متغیرهای محیطی
#  این فایل را به `.env` کپی کنید و مقادیر را تغییر دهید.
#  هرگز فایل `.env` واقعی را در Git کامیت نکنید.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME=Darin
API_PORT=3001
WEB_PORT=5173
# آدرس عمومی رابط کاربری — برای CORS و لینک داخل QR Code
PUBLIC_WEB_URL=http://localhost:5173

# ── پایگاه داده ──────────────────────────────────────────────
DATABASE_URL=postgresql://darin:darin_dev_password@localhost:5432/darin?schema=public

# ── Redis (صف کارهای پس‌زمینه و Cache) ────────────────────────
REDIS_URL=redis://localhost:6379
# اگر Redis در دسترس نباشد، سیستم بدون صف کار می‌کند و Jobها همزمان اجرا می‌شوند
QUEUE_ENABLED=true

# ── امنیت ────────────────────────────────────────────────────
# با `openssl rand -base64 48` تولید کنید. حداقل ۳۲ نویسه.
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_DIFFERENT_secret_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# کوکی امن — در Production حتماً true (نیازمند HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
# دامنه‌های مجاز CORS، جداشده با کاما
CORS_ORIGINS=http://localhost:5173

# محدودیت نرخ درخواست
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
# محدودیت سخت‌گیرانه‌تر برای ورود
RATE_LIMIT_LOGIN_MAX=10

# ── ذخیره‌سازی فایل ──────────────────────────────────────────
# local | s3  (فعلاً فقط local پیاده‌سازی شده)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_MB=15

# ── پشتیبان‌گیری ─────────────────────────────────────────────
BACKUP_PATH=./storage/backups
# مسیر ابزارهای PostgreSQL (اگر در PATH نیستند)
PG_DUMP_PATH=pg_dump
PSQL_PATH=psql

# ── Log ──────────────────────────────────────────────────────
LOG_LEVEL=info
# خروجی خوانا برای توسعه؛ در Production روی json بگذارید
LOG_PRETTY=true

# ── اعلان‌ها (اختیاری — در نسخه فعلی فقط IN_APP فعال است) ─────
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
