{
  "name": "darin",
  "version": "0.1.0",
  "private": true,
  "description": "Darin — Professional Library Management System (سامانه جامع مدیریت کتابخانه)",
  "engines": { "node": ">=20.10.0" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @darin/shared build && pnpm --filter @darin/api build && pnpm --filter @darin/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @darin/api db:migrate",
    "db:seed": "pnpm --filter @darin/api db:seed",
    "db:reset": "pnpm --filter @darin/api db:reset",
    "seed:perf": "pnpm --filter @darin/api seed:perf"
  }
}
