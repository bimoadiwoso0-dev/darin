{
  "name": "darin",
  "version": "0.1.0",
  "private": true,
  "description": "Darin — Professional Library Management System (سامانه جامع مدیریت کتابخانه)",
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepare:workspace": "pnpm --filter @darin/shared build && pnpm --filter @darin/api exec prisma generate",
    "dev": "pnpm --filter @darin/shared build && pnpm --parallel --filter \"./apps/*\" --filter @darin/shared dev",
    "build": "pnpm --filter @darin/shared build && pnpm --filter @darin/api build && pnpm --filter @darin/web build",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:create": "pnpm --filter @darin/api db:create",
    "db:migrate": "pnpm --filter @darin/api db:migrate",
    "db:seed": "pnpm --filter @darin/api db:seed",
    "db:reset": "pnpm --filter @darin/api db:reset",
    "seed:perf": "pnpm --filter @darin/api seed:perf",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8"
  }
}
